# Cloudflare R2 credentials for /usr/local/bin/myfood-backup-r2
# Copy to /etc/myfood-backup.env on VM 101 (chmod 600, owned by root:root).
R2_ENDPOINT=https://9e28339d944a3d25ce5bff907ccfb6e2.r2.cloudflarestorage.com
R2_BUCKET=myfood-backups
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_PREFIX=myfood
R2_RETENTION_DAYS=30

# /etc/myfood-mcp.env — optional secrets for the remote /mcp endpoint.
# Copy to /etc/myfood-mcp.env on VM 101 (never commit real secrets to deploy/myfood.env,
# which scripts/deploy.sh overwrites on every deploy).
#
# myfood.service runs as User=pantry, so set permissions to:
#   sudo chown pantry:pantry /etc/myfood-mcp.env && sudo chmod 600 /etc/myfood-mcp.env
# (or root:pantry with chmod 640).
#
# Generate with: openssl rand -hex 32
MCP_SECRET=replace-with-openssl-rand-hex-32

# /etc/myfood.env — no secrets in here.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DATA_DIR=/var/lib/myfood
# Job folders (receipt photos) sit outside the data folder: the agy user may read these and nothing else.
JOBS_DIR=/var/lib/myfood-jobs
WEB_DIR=/opt/myfood/dist/web
TZ=Europe/Copenhagen
# The AI runs as the unix user agy, which can read only /var/lib/myfood/jobs.
AI_CMD=sudo -n -u agy /usr/local/bin/run-agy

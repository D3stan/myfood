# Local test & development configuration for MyFood
# Copy to .env for local runs (`npm run dev:server`, `npm start`, `npm run seed`).
# Note: Production systemd uses /etc/myfood.env (see deploy/myfood.env).

HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
JOBS_DIR=./data/jobs
WEB_DIR=dist/web
TZ=Europe/Copenhagen

# Allow session cookies over plain http://localhost / http://127.0.0.1 during local testing.
# Set to 0 or omit in HTTPS / Cloudflare Tunnel production.
INSECURE_COOKIES=1

# AI runner:
# - Local mock (no agy login required): node scripts/fake-agy.mjs
# - Local real agy CLI: agy
# - Homelab VM systemd: sudo -n -u agy /usr/local/bin/run-agy
AI_CMD=node scripts/fake-agy.mjs
AI_MODEL=gemini-3.8-flash-low
AI_EFFORT=low
AI_TIMEOUT_MS=180000
# Optional fake-agy test mode: ok | garbage | wrong-shape | denied | exit-nonzero | not-signed-in | slow
# FAKE_AGY=ok

# Web Push VAPID contact URI (keys themselves are auto-generated and stored in SQLite meta table)
VAPID_SUBJECT=mailto:admin@food.0xpuddu.com

# Optional bearer secret for the remote /mcp Streamable HTTP endpoint.
# Generate one with: openssl rand -hex 32
# MCP_SECRET=
